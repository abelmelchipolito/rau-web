---
// src/components/Hero.astro

import fondoLimpio from '../assets/fondo-limpio.jpg';
import virgenTransparente from '../assets/virgen-transparente.png';
import buho from '../assets/Buho.png';
---

<section class="relative w-full min-h-[85vh] flex items-center overflow-hidden bg-yeso-cream">
    <!-- 1. CAPA 1: EL Fondo Limpio Estático -->
    <div class="absolute inset-0 z-0">
        <!-- En móvil: blur-md difumina TODA la imagen + scale-110 la agranda un poco -->
        <!-- En desktop (md+): blur-none y scale-100 regresan a la imagen a su estado original -->
        <img
            src={fondoLimpio.src}
            alt="Taller de arte en yeso"
            class="w-full h-full object-contain object-right origin-right scale-110 md:scale-100 blur-md md:blur-none"
        />

        <!-- Máscara de fundido horizontal: 100% sólido a la izquierda, desapareciendo hacia la derecha -->
        <div class="absolute inset-0 bg-gradient-to-r from-yeso-cream from-[45%] via-yeso-cream/90 via-[55%] to-transparent"></div>

        <!-- Velo extra SOLO en móvil, para dar contraste ya que el fondo está difuminado -->
        <div class="absolute inset-0 bg-yeso-cream/50 md:hidden"></div>
    </div>

    <!-- 2. Contenido principal -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 py-20 md:px-12 lg:px-20">
        <div class="max-w-xl">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-yeso-terra">
                Figuras de yeso artesanales
            </p>

            <h1 class="mb-6 text-4xl font-black leading-tight text-slate-900 sm:text-5xl lg:text-6xl">
                Figuras de Yeso
                <span class="block text-yeso-terra">Los Tuxtlas</span>
            </h1>

            <p class="mb-8 text-base leading-relaxed text-slate-700 sm:text-lg">
                Figuras, recuerdos y paquetes personalizados para fiestas infantiles,
                bautizos, primeras comuniones, bodas y eventos especiales.
            </p>

            <div class="flex flex-col gap-4 sm:flex-row">
                <a
                    href="#servicios"
                    class="inline-flex items-center justify-center rounded-full bg-yeso-terra px-7 py-3 font-bold text-white transition-all duration-300 hover:scale-105 hover:bg-orange-700"
                >
                    Ver servicios
                </a>

                <a
                    href="https://wa.me/522941025503"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center rounded-full border-2 border-slate-900 px-7 py-3 font-bold text-slate-900 transition-all duration-300 hover:bg-slate-900 hover:text-white"
                >
                    Cotizar por WhatsApp
                </a>
            </div>

            <!-- Tarjeta de garantía -->
            <div class="mt-10 max-w-sm rounded-[2rem] bg-slate-900/95 p-6 text-white shadow-xl">
                <h2 class="mb-2 text-xl font-extrabold">
                    ¿Quiere asegurar su pedido?
                </h2>

                <p class="text-sm leading-relaxed text-slate-200">
                    Garantizamos la elaboración y entrega de sus productos desde que se
                    realiza el 50% del pago total.
                </p>
            </div>
        </div>
    </div>

    <!-- 3. Imágenes decorativas -->
    <img
        src={virgenTransparente.src}
        alt="Figura religiosa de yeso"
        class="pointer-events-none absolute bottom-0 right-4 z-20 hidden h-48 w-auto object-contain drop-shadow-xl md:block md:h-56 lg:h-72"
    />

    <img
        src={buho.src}
        alt="Figura decorativa de búho"
        class="pointer-events-none absolute bottom-2 right-52 z-20 hidden h-32 w-auto object-contain drop-shadow-lg lg:block lg:h-44"
    />
</section>