---
// src/components/Hero.astro
---
<section class="relative w-full min-h-[85vh] flex items-center overflow-hidden bg-yeso-cream">

    <!-- 1. CAPA 1: El Fondo Limpio Estático -->
    <div class="absolute inset-0 z-0">
        <!-- En móvil: blur-md difumina TODA la imagen + scale-110 la agranda un poco -->
        <!-- En desktop (md+): blur-none y scale-100 regresan la imagen a su estado original -->
        <img 
            src="/src/assets/fondo-limpio.jpg" 
            alt="Taller de arte en yeso" 
            class="w-full h-full object-contain object-right origin-right scale-110 md:scale-100 blur-md md:blur-none"
        />
        <!-- Máscara de fundido horizontal: 100% sólido a la izquierda, desapareciendo hacia la derecha -->
        <div class="absolute inset-0 bg-gradient-to-r from-yeso-cream from-45% via-yeso-cream/90 via-55% to-transparent"></div>

        <!-- Velo extra SOLO en móvil, para dar contraste ya que el fondo está difuminado -->
        <div class="absolute inset-0 bg-yeso-cream/50 md:hidden"></div>
    </div>


    <!-- 2. CAPA 2: La Virgen Flotante GRANDE (SOLO en desktop/tablet, oculta en móvil) -->
    <div class="absolute inset-0 z-10 pointer-events-none hidden md:block">
        <img 
            src="/src/assets/virgen-transparente.png" 
            alt="Figura de yeso Virgencita" 
            class="w-full h-full object-contain object-right hero-floating drop-shadow-[0_20px_30px_rgba(0,0,0,0.25)]"
        />
    </div>


    <!-- 3. CAPA 3: Textos e Interfaz -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20 pb-16">
        <div class="max-w-xl relative">

            <!-- Virgencita GRANDE flotando de fondo, detrás del texto, SOLO en móvil (10x más grande que el ícono anterior) -->
            <img 
                src="/src/assets/virgen-transparente.png" 
                alt="Figura de yeso Virgencita" 
                class="absolute -top-45 -right-10 w-[330px] h-[330px] object-contain hero-floating drop-shadow-[0_15px_20px_rgba(0,0,0,0.2)] pointer-events-none -z-10 md:hidden"
            />

            <div class="flex items-center gap-4 mb-6">
                <span class="w-8 h-[2px] bg-yeso-teal"></span>
                <span class="text-yeso-teal font-bold tracking-widest text-sm uppercase">Hecho a mano</span>
            </div>
            
            <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 leading-[1.1] mb-6 tracking-tight">
                Arte en yeso <br />
                <span class="font-light italic text-slate-600">para tus espacios.</span>
            </h1>
            
            <p class="text-lg text-slate-600 mb-10 leading-relaxed font-light max-w-md">
                Diseños limpios, pulidos a mano y listos para dar vida a tus eventos o proyectos creativos.
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4">
                <a href="https://wa.me/522942660849" class="px-8 py-4 bg-yeso-terra text-white font-bold rounded-full text-center hover:bg-orange-600 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 pointer-events-auto">
                    Iniciar un pedido
                </a>
                <a href="https://wa.me/522942660849" class="px-8 py-4 bg-white text-slate-800 font-bold rounded-full text-center hover:bg-slate-50 shadow-sm border border-slate-100 hover:shadow-md transition-all duration-300 pointer-events-auto">
                    Ver proceso
                </a>
            </div>
        </div>
    </div>
</section>


<style>
    .hero-floating {
        animation: floatHero 6s ease-in-out infinite;
    }


    @keyframes floatHero {
        0% { transform: translateY(0px); }
        50% { transform: translateY(-15px); }
        100% { transform: translateY(0px); }
    }
</style>
