---
import fondoLimpio from '../assets/fondo-limpio.jpg';
import virgenTransparente from '../assets/virgen-transparente.png';
import buho from '../assets/Buho.png';
---

<section
  id="inicio"
  class="relative min-h-[85vh] w-full overflow-hidden bg-yeso-cream flex items-center"
>
  <!-- Fondo del hero -->
  <div class="absolute inset-0 z-0">
    <img
      src={fondoLimpio.src}
      alt="Taller de arte en yeso"
      class="h-full w-full object-contain object-right origin-right scale-110 blur-md md:scale-100 md:blur-none"
    />

    <!-- Degradado: mejora la lectura del texto -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-yeso-cream from-[45%] via-yeso-cream/90 via-[55%] to-transparent"
    ></div>

    <!-- Capa extra para móvil -->
    <div class="absolute inset-0 bg-yeso-cream/50 md:hidden"></div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 mx-auto w-full max-w-7xl px-6 py-20 md:px-12 lg:px-20">
    <div class="max-w-xl">
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.2em] text-orange-500">
        Arte hecho a mano
      </p>

      <h1 class="mb-6 text-4xl font-black leading-tight text-slate-900 sm:text-5xl lg:text-6xl">
        Figuras de yeso para hacer especiales tus momentos
      </h1>

      <p class="mb-8 text-base leading-relaxed text-slate-700 sm:text-lg">
        Creamos figuras de yeso, recuerdos y paquetes personalizados para fiestas,
        eventos y celebraciones. Cada pieza se elabora con dedicación y cuidado.
      </p>

      <div class="flex flex-col gap-4 sm:flex-row">
        <a
          href="#servicios"
          class="inline-flex items-center justify-center rounded-full bg-orange-500 px-7 py-3 font-bold text-white transition hover:bg-orange-600"
        >
          Ver servicios
        </a>

        <a
          href="#contacto"
          class="inline-flex items-center justify-center rounded-full border-2 border-slate-900 px-7 py-3 font-bold text-slate-900 transition hover:bg-slate-900 hover:text-white"
        >
          Solicitar información
        </a>
      </div>

      <!-- Tarjeta de garantía -->
      <div class="mt-10 max-w-sm rounded-[2rem] bg-slate-900/95 p-6 text-white shadow-xl">
        <h2 class="mb-2 text-xl font-extrabold">
          ¿Quieres asegurar tu pedido?
        </h2>

        <p class="text-sm leading-relaxed text-slate-200">
          Garantizamos la elaboración y entrega de tus productos desde que se realiza
          el 50% del pago total.
        </p>
      </div>
    </div>
  </div>

  <!-- Figuras decorativas -->
  <img
    src={virgenTransparente.src}
    alt="Figura religiosa de yeso"
    class="pointer-events-none absolute bottom-0 right-4 z-20 hidden h-48 w-auto object-contain drop-shadow-xl md:block md:h-56 lg:h-72"
  />

  <img
    src={buho.src}
    alt="Figura decorativa de búho"
    class="pointer-events-none absolute bottom-2 right-52 z-20 hidden h-32 w-auto object-contain drop-shadow-lg lg:block lg:h-44"
  />
</section>