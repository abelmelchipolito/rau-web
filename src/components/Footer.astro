        <!-- Línea inferior: derechos + créditos de diseño -->
        <div class="w-full pt-8 border-t border-slate-100 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-sm text-slate-500">
                &copy; {currentYear} Figuras de Yeso Los Tuxtlas. Todos los derechos reservados.
            </p>

            <!-- TU ANZUELO PROFESIONAL -->
            <div class="px-5 py-2.5 bg-slate-50 rounded-full border border-slate-200 hover:border-amber-300 transition-colors">
                <p class="text-sm text-slate-600">
                    Sitio web creado por <span class="font-bold text-amber-600">Melchisoft</span>.
                    <a href="https://wa.me/522941025503" target="_blank" rel="noopener noreferrer"
                       class="ml-1 underline decoration-slate-300 hover:decoration-amber-600 hover:text-amber-700 transition-all">
                        ¿Quieres una web así para tu negocio?
