---
// src/components/Header.astro
---
<header class="fixed w-full top-0 z-50 transition-all duration-500 bg-white/70 backdrop-blur-xl border-b border-white/50" id="main-header">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20 transition-all duration-500" id="header-container">
            
            <!-- Logo / Nombre del negocio -->
            <div class="flex-shrink-0 flex items-center">
                <a href="#" class="text-2xl tracking-tighter group flex items-center gap-2">
                    <span class="font-light text-slate-800 group-hover:text-slate-600 transition-colors">Figuras De Yeso</span>
                    <span class="font-bold text-yeso-terra group-hover:text-yeso-teal transition-colors duration-500">Los Tuxtlas</span>
                </a>
            </div>

            <!-- Navegación de escritorio (Desktop) -->
            <nav class="hidden md:flex space-x-10 items-center">
                <a href="#calidad" class="relative group text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
                    Calidad Artesanal
                    <!-- Línea animada inferior -->
                    <span class="absolute -bottom-1.5 left-1/2 w-0 h-[2px] bg-yeso-teal group-hover:w-full group-hover:left-0 transition-all duration-300 ease-out rounded-full"></span>
                </a>
                <a href="#servicios" class="relative group text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors">
                    Servicios
                    <span class="absolute -bottom-1.5 left-1/2 w-0 h-[2px] bg-yeso-teal group-hover:w-full group-hover:left-0 transition-all duration-300 ease-out rounded-full"></span>
                </a>
            </nav>

            <!-- Botón CTA de WhatsApp (Desktop) -->
            <div class="hidden md:flex items-center">
                <a 
                    href="https://wa.me/522942660849?text=Hola,%20vengo%20de%20la%20página%20web%20y%20quiero%20información%20sobre%20las%20figuras." 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="group inline-flex items-center justify-center px-6 py-2.5 bg-slate-900 text-white text-sm font-medium rounded-full shadow-[0_4px_14px_0_rgb(0,0,0,0.1)] hover:bg-yeso-terra hover:shadow-[0_6px_20px_rgba(0,0,0,0.15)] hover:-translate-y-0.5 transition-all duration-300"
                >
                    <span class="mr-2 text-green-400 group-hover:scale-110 transition-transform duration-300">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                    </span>
                    Cotizar Pedido
                </a>
            </div>

            <!-- Botón de menú para móvil (Hamburguesa) -->
            <div class="flex items-center md:hidden">
                <button type="button" id="mobile-menu-button" class="inline-flex items-center justify-center p-2 rounded-full text-slate-600 hover:text-yeso-terra hover:bg-slate-100 focus:outline-none transition-colors" aria-expanded="false">
                    <span class="sr-only">Abrir menú principal</span>
                    <svg class="block h-6 w-6 transition-transform duration-300" id="icon-menu" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg class="hidden h-6 w-6 transition-transform duration-300 rotate-90" id="icon-close" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Menú Desplegable para Móviles -->
    <div class="md:hidden hidden bg-white/95 backdrop-blur-xl border-b border-slate-100 absolute w-full shadow-2xl transition-all duration-300 origin-top" id="mobile-menu">
        <div class="px-6 pt-4 pb-8 space-y-2">
            <a href="#calidad" class="block px-4 py-3 rounded-2xl text-base font-medium text-slate-700 hover:text-yeso-terra hover:bg-yeso-cream transition-colors">Calidad Artesanal</a>
            <a href="#servicios" class="block px-4 py-3 rounded-2xl text-base font-medium text-slate-700 hover:text-yeso-terra hover:bg-yeso-cream transition-colors">Servicios</a>
            
            <div class="pt-6 pb-2">
                <a 
                    href="https://wa.me/522942660849?text=Hola,%20vengo%20de%20la%20página%20web%20y%20quiero%20información%20sobre%20las%20figuras." 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-full px-5 py-4 text-center font-medium text-white bg-slate-900 rounded-2xl shadow-lg hover:bg-yeso-terra transition-colors"
                >
                    Cotizar por WhatsApp
                </a>
            </div>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const header = document.getElementById('main-header');
        const headerContainer = document.getElementById('header-container');
        const btn = document.getElementById('mobile-menu-button');
        const menu = document.getElementById('mobile-menu');
        const iconMenu = document.getElementById('icon-menu');
        const iconClose = document.getElementById('icon-close');
        
        // Efecto elegante al hacer scroll (AQUÍ ESTÁ LA CORRECCIÓN)
        // Validamos que header y headerContainer existan antes de ejecutar el scroll
        if (header && headerContainer) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 20) {
                    header.classList.add('shadow-[0_8px_30px_rgb(0,0,0,0.04)]', 'bg-white/85');
                    header.classList.remove('bg-white/70');
                    headerContainer.classList.remove('h-20');
                    headerContainer.classList.add('h-16'); // Se hace más delgado
                } else {
                    header.classList.remove('shadow-[0_8px_30px_rgb(0,0,0,0.04)]', 'bg-white/85');
                    header.classList.add('bg-white/70');
                    headerContainer.classList.add('h-20');
                    headerContainer.classList.remove('h-16');
                }
            });
        }

        // Toggle del menú móvil
        const mobileLinks = menu?.querySelectorAll('a');

        if (btn && menu && iconMenu && iconClose) {
            btn.addEventListener('click', () => {
                const expanded = btn.getAttribute('aria-expanded') === 'true' || false;
                btn.setAttribute('aria-expanded', String(!expanded));
                
                // Animación de aparición suave
                if (!expanded) {
                    menu.classList.remove('hidden');
                    setTimeout(() => menu.classList.remove('opacity-0', '-translate-y-2'), 10);
                } else {
                    menu.classList.add('opacity-0', '-translate-y-2');
                    setTimeout(() => menu.classList.add('hidden'), 300);
                }

                iconMenu.classList.toggle('hidden');
                iconClose.classList.toggle('hidden');
                iconClose.classList.remove('rotate-90'); 
            });

            if (mobileLinks) {
                mobileLinks.forEach(link => {
                    link.addEventListener('click', () => {
                        menu.classList.add('opacity-0', '-translate-y-2');
                        setTimeout(() => menu.classList.add('hidden'), 300);
                        iconMenu.classList.remove('hidden');
                        iconClose.classList.add('hidden');
                        btn.setAttribute('aria-expanded', 'false');
                    });
                });
            }
        }
    });
</script>