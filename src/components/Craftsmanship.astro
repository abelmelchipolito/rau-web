---
import figura2 from '../assets/figura_2.jpg';

// src/components/Craftsmanship.astro
---

<section class="relative py-24 lg:py-32 overflow-hidden bg-white group" id="calidad">


    <!-- Imagen de fondo a pantalla completa -->
    <div class="absolute inset-0 z-0 overflow-hidden">
        <img 
            src={figura2.src}
            alt="Figura de yeso artesanal pulida y lista para pintar" 
            loading="lazy"
            class="w-full h-full object-cover object-center lg:object-right saturate-[1.05] contrast-[1.03] scale-105 group-hover:scale-100 transition-transform duration-[10s] ease-out"
        />
        <!-- Máscara de degradado más suave y natural -->
        <div class="absolute inset-0 bg-gradient-to-r from-white via-white/90 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-white via-white/40 to-transparent lg:hidden"></div>
    </div>


    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-10">


            <!-- Columna de Texto -->
            <div class="w-full lg:w-1/2 space-y-8">


                <div class="inline-flex items-center gap-3">
                    <span class="w-10 h-[2px] bg-yeso-terra"></span>
                    <p class="text-sm font-bold text-yeso-terra tracking-widest uppercase">
                        Detalle Perfecto
                    </p>
                </div>


                <h2 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                    La calidad que <br />
                    <span class="font-light italic text-slate-500">nos distingue.</span>
                </h2>


                <p class="text-lg text-slate-600 leading-relaxed font-light max-w-md">
                    Olvídate de las figuras porosas o con bordes rasposos. Cada una de nuestras piezas es vaciada con yeso de alta densidad y pulida meticulosamente para ofrecerte un lienzo impecable.
                </p>


                <!-- Lista con Micro-interacciones -->
                <ul class="space-y-6 mt-8">
                    <li class="flex items-center group/item cursor-default">
                        <span class="flex-shrink-0 h-10 w-10 rounded-full bg-yeso-cream flex items-center justify-center text-yeso-teal group-hover/item:bg-yeso-teal group-hover/item:text-white group-hover/item:scale-110 group-hover/item:shadow-md transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        </span>
                        <span class="ml-4 font-medium text-slate-600 group-hover/item:text-slate-900 group-hover/item:translate-x-1 transition-all duration-300">Acabado pulido a mano, cero rebabas.</span>
                    </li>
                    <li class="flex items-center group/item cursor-default">
                        <span class="flex-shrink-0 h-10 w-10 rounded-full bg-yeso-cream flex items-center justify-center text-yeso-teal group-hover/item:bg-yeso-teal group-hover/item:text-white group-hover/item:scale-110 group-hover/item:shadow-md transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        </span>
                        <span class="ml-4 font-medium text-slate-600 group-hover/item:text-slate-900 group-hover/item:translate-x-1 transition-all duration-300">Yeso de alta densidad y resistencia.</span>
                    </li>
                    <li class="flex items-center group/item cursor-default">
                        <span class="flex-shrink-0 h-10 w-10 rounded-full bg-yeso-cream flex items-center justify-center text-yeso-teal group-hover/item:bg-yeso-teal group-hover/item:text-white group-hover/item:scale-110 group-hover/item:shadow-md transition-all duration-300">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                        </span>
                        <span class="ml-4 font-medium text-slate-600 group-hover/item:text-slate-900 group-hover/item:translate-x-1 transition-all duration-300">Listas para absorber cualquier acrílico.</span>
                    </li>
                </ul>
            </div>


            <!-- Columna Derecha (Imagen y Elementos Flotantes) -->
            <div class="w-full lg:w-1/2 relative h-[320px] lg:h-[550px]">


                <!-- Tarjeta flotante (Glassmorphism + Animación vertical) -->
                <div class="absolute bottom-6 left-1/2 -translate-x-1/2 lg:left-8 lg:translate-x-0 bg-white/70 backdrop-blur-md py-3.5 px-7 rounded-full shadow-[0_8px_30px_rgb(0,0,0,0.08)] border border-white/50 flex items-center gap-3 floating-badge z-20">
                    <div class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yeso-teal opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-yeso-teal"></span>
                    </div>
                    <p class="text-xs font-bold text-slate-800 uppercase tracking-widest">Listas para pintar</p>
                </div>


                <!-- Sello decorativo giratorio tipo certificado -->
                <div class="absolute top-4 right-8 lg:right-12 h-24 w-24 rounded-full bg-white/90 backdrop-blur-sm shadow-xl border-4 border-yeso-cream flex items-center justify-center spinning-seal z-20">
                    <div class="absolute inset-2 rounded-full border border-dashed border-yeso-terra/40"></div>
                    <span class="text-yeso-terra font-serif italic text-sm font-bold leading-tight text-center">100%<br/>Artesanal</span>
                </div>
            </div>


        </div>
    </div>
</section>


<style>
    /* Hace que la etiqueta inferior flote suavemente */
    .floating-badge {
        animation: floatBadge 4s ease-in-out infinite;
    }


    /* Hace que el sello gire muy lentamente, como una insignia de calidad */
    .spinning-seal {
        animation: spinSeal 15s linear infinite;
    }


    @keyframes floatBadge {
        0%, 100% { transform: translate(-50%, 0px); }
        50% { transform: translate(-50%, -10px); }
    }


    /* Ajuste de animación para pantallas grandes donde el translate-x es 0 */
    @media (min-width: 1024px) {
        @keyframes floatBadge {
            0%, 100% { transform: translate(0, 0px); }
            50% { transform: translate(0, -10px); }
        }
    }


    @keyframes spinSeal {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>